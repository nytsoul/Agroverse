# Server Configuration
PORT=3001

# Blockchain Configuration (Arbitrum Sepolia)
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
AGRI_TRUTH_CHAIN_ADDRESS=0xYourContractAddressHere
RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKeyHere
OWNER_PRIVATE_KEY=0xYourOwnerPrivateKeyHere

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_YourStripeSecretKeyHere
STRIPE_WEBHOOK_SECRET=whsec_YourWebhookSecretHere

# OpenWeather API Configuration
OPENWEATHER_API_KEY=YourOpenWeatherAPIKeyHere
OPENWEATHER_UNITS=metric

# OpenRouteService API Configuration
ORS_API_KEY=YourORSAPIKeyHere

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/agroverse
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agroverse?retryWrites=true&w=majority

# WhatsApp/N8N Webhook Configuration (Optional)
N8N_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_URL=

# IPFS Configuration (Optional)
PINATA_API_KEY=
PINATA_SECRET_KEY=
